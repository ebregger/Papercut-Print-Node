  "_readme": [
    "Copy to credentials.json and fill in your PaperCut login.",
    "  cp config/credentials.json.example config/credentials.json",
    "  chmod 600 config/credentials.json",
    "NEVER commit credentials.json. It is gitignored."
  ],
  "accounts": {
    "default": {
      "username": "YOUR_PAPERCUT_USERNAME",
      "password": "PASTE_YOUR_PAPERCUT_PASSWORD_HERE"
    }
  }
}
